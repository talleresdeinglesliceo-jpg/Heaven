	local lastUpdate = 0
	local frameCount = 0
	local currentFps = 60

	-- ===== SEGUIMIENTO VISUAL AL TORSO DE ENEMIGOS SIN OBSTÁCULOS =====
	local throttle = 0
	local torsoYOffset = -8
	local shortestDistance = 460

	RunService.RenderStepped:Connect(function(dt)
		frameCount = frameCount + 1
		lastUpdate = lastUpdate + dt
		if lastUpdate >= 0.5 then
			currentFps = math.floor(frameCount / lastUpdate + 0.5)
			frameCount = 0
			lastUpdate = 0
		end

		local pingVal = 0
		pcall(function()
			pingVal = math.floor(player:GetNetworkPing() * 1000)
		end)

		lblFps.Text = string.format("FPS.........: %d", currentFps)
		lblPhysics.Text = string.format("Physics.....: %.1f / %.1f msec", dt * 1000, 16.6)
		lblRender.Text = string.format("Render......: %.1f / %.1f msec", dt * 1000, 16.6)
		lblNetwork.Text = string.format("Network receive: %d ms ping", pingVal)

		local currentCam = Workspace.CurrentCamera
		camera = currentCam

		local myChar = player.Character
		if not myChar or not camera then
			lockedTargetTorso = nil
			return
		end

		local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
		if not myHumanoid or myHumanoid.Health <= 0 then
			lockedTargetTorso = nil
			return
		end

		local hasWeapon = myChar:FindFirstChildOfClass("Tool") ~= nil

		if hasWeapon then
			throttle = throttle + dt
			if throttle >= 0.02 then
				throttle = 0

				local bestTarget = nil
				local bestDist = shortestDistance
				local centerScreen = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)

				if lockedTargetTorso and lockedTargetTorso.Parent then
					local enemyChar = lockedTargetTorso.Parent
					local enemyPlayer = Players:GetPlayerFromCharacter(enemyChar)
					local humanoid = enemyChar:FindFirstChildOfClass("Humanoid")

					if enemyPlayer and isEnemy(enemyPlayer) and humanoid and humanoid.Health > 0 then
						local screenPoint, onScreen = camera:WorldToViewportPoint(lockedTargetTorso.Position)
						if onScreen and screenPoint.Z > 0 and isNotCovered(camera, myChar, enemyChar, lockedTargetTorso) then
							bestTarget = lockedTargetTorso
						end
					end
				end

				if not bestTarget then
					for _, otherPlayer in ipairs(Players:GetPlayers()) do
						if isEnemy(otherPlayer) then
							local enemyChar = otherPlayer.Character
							if enemyChar then
								local humanoid = enemyChar:FindFirstChildOfClass("Humanoid")
								local torso = getTargetTorso(enemyChar)

								if humanoid and humanoid.Health > 0 and torso then
									local screenPoint, onScreen = camera:WorldToViewportPoint(torso.Position)
									if onScreen and screenPoint.Z > 0 then
										local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - centerScreen).Magnitude
										if dist < bestDist and isNotCovered(camera, myChar, enemyChar, torso) then
											bestDist = dist
											bestTarget = torso
										end
									end
								end
							end
						end
					end
				end

				lockedTargetTorso = bestTarget
			end

			if lockedTargetTorso and lockedTargetTorso.Parent then
				local screenPoint, onScreen = camera:WorldToViewportPoint(lockedTargetTorso.Position)
				if onScreen and screenPoint.Z > 0 and isNotCovered(camera, myChar, lockedTargetTorso.Parent, lockedTargetTorso) then
					local targetPos = UDim2.new(0, screenPoint.X, 0, screenPoint.Y + torsoYOffset)
					crosshairContainer.Position = crosshairContainer.Position:Lerp(targetPos, 0.65)
				else
					lockedTargetTorso = nil
					crosshairContainer.Position = crosshairContainer.Position:Lerp(defaultPos, 0.45)
				end
			else
				crosshairContainer.Position = crosshairContainer.Position:Lerp(defaultPos, 0.45)
			end
		else
			lockedTargetTorso = nil
			crosshairContainer.Position = crosshairContainer.Position:Lerp(defaultPos, 0.45)
		end
	end)

	-- Detección de armas en el personaje
	local function monitorCharacter(char)
		local function checkWeapon()
			local equipped = false
			for _, item in ipairs(char:GetChildren()) do
				if item:IsA("Tool") then
					equipped = true
					break
				end
			end
			setCrosshairStyle(equipped)
		end

		checkWeapon()

		char.ChildAdded:Connect(function(child)
			if child:IsA("Tool") then
				task.defer(checkWeapon)
			end
		end)

		char.ChildRemoved:Connect(function(child)
			if child:IsA("Tool") then
				task.defer(checkWeapon)
			end
		end)
	end

	if player.Character then
		monitorCharacter(player.Character)
	end

	player.CharacterAdded:Connect(monitorCharacter)
end

