	local function refreshTeamList()
		for _, child in ipairs(listScroll:GetChildren()) do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end

		local allPlayers = Players:GetPlayers()
		local blueList = {}
		local redList = {}

		for _, p in ipairs(allPlayers) do
			if not playerManualSide[p.UserId] then
				playerManualSide[p.UserId] = (p == player) and "BLUE" or "RED"
			end
			if playerManualSide[p.UserId] == "BLUE" then
				table.insert(blueList, p)
			else
				table.insert(redList, p)
			end
		end

		local orderCounter = 1
		createGroupHeader("BLUE", Color3.fromRGB(90, 175, 255), orderCounter)
		orderCounter = orderCounter + 1

		for _, p in ipairs(blueList) do
			local inMatch = isInMatchWithMe(p)
			local sideBtn, toggleNoBtn = createPlayerEntry(p, "BLUE", inMatch, orderCounter)
			orderCounter = orderCounter + 1

			sideBtn.MouseButton1Click:Connect(function()
				playerManualSide[p.UserId] = "RED"
				lockedTargetTorso = nil
				refreshTeamList()
			end)

			toggleNoBtn.MouseButton1Click:Connect(function()
				playerExcludedNo[p.UserId] = not playerExcludedNo[p.UserId]
				if playerExcludedNo[p.UserId] and lockedTargetTorso and lockedTargetTorso.Parent and lockedTargetTorso.Parent == p.Character then
					lockedTargetTorso = nil
				end
				refreshTeamList()
			end)
		end

		createGroupHeader("RED", Color3.fromRGB(255, 95, 105), orderCounter)
		orderCounter = orderCounter + 1

		for _, p in ipairs(redList) do
			local inMatch = isInMatchWithMe(p)
			local sideBtn, toggleNoBtn = createPlayerEntry(p, "RED", inMatch, orderCounter)
			orderCounter = orderCounter + 1

			sideBtn.MouseButton1Click:Connect(function()
				playerManualSide[p.UserId] = "BLUE"
				lockedTargetTorso = nil
				refreshTeamList()
			end)

			toggleNoBtn.MouseButton1Click:Connect(function()
				playerExcludedNo[p.UserId] = not playerExcludedNo[p.UserId]
				if playerExcludedNo[p.UserId] and lockedTargetTorso and lockedTargetTorso.Parent and lockedTargetTorso.Parent == p.Character then
					lockedTargetTorso = nil
				end
				refreshTeamList()
			end)
		end

		task.defer(function()
			listScroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 6)
		end)
	end

