-- ===== AUTOGUARDADO SILENCIOSO DE CURSORES =====
local SAVE_FILE = "HeavenCrosshairConfig.json"

local function loadSavedCrosshairs(playerGui)
	local unarmed = "PuntoSombra"
	local armed = "MiraFucsia"

	pcall(function()
		if type(isfile) == "function" and type(readfile) == "function" and isfile(SAVE_FILE) then
			local decoded = HttpService:JSONDecode(readfile(SAVE_FILE))
			if type(decoded) == "table" then
				if isValidStyle(decoded.unarmed) then
					unarmed = decoded.unarmed
				end
				if isValidStyle(decoded.armed) then
					armed = decoded.armed
				end
			end
		end
	end)

	pcall(function()
		local env = (type(getgenv) == "function") and getgenv() or nil
		if env and type(env.HeavenSavedCrosshairs) == "table" then
			if isValidStyle(env.HeavenSavedCrosshairs.unarmed) then
				unarmed = env.HeavenSavedCrosshairs.unarmed
			end
			if isValidStyle(env.HeavenSavedCrosshairs.armed) then
				armed = env.HeavenSavedCrosshairs.armed
			end
		end
	end)

	if playerGui then
		local attrU = playerGui:GetAttribute("HeavenUnarmedStyle")
		local attrA = playerGui:GetAttribute("HeavenArmedStyle")
		if isValidStyle(attrU) then unarmed = attrU end
		if isValidStyle(attrA) then armed = attrA end
	end

	return unarmed, armed
end

local function saveCrosshairsSilently(playerGui, unarmed, armed)
	pcall(function()
		local env = (type(getgenv) == "function") and getgenv() or nil
		if env then
			env.HeavenSavedCrosshairs = {
				unarmed = unarmed,
				armed = armed
			}
		end
	end)

	if playerGui then
		pcall(function()
			playerGui:SetAttribute("HeavenUnarmedStyle", unarmed)
			playerGui:SetAttribute("HeavenArmedStyle", armed)
		end)
	end

	pcall(function()
		if type(writefile) == "function" then
			writefile(SAVE_FILE, HttpService:JSONEncode({
				unarmed = unarmed,
				armed = armed
			}))
		end
	end)
end

-- ===== DETECCIÓN DE JUGADOR EN PARTIDA ACTIVA CONMIGO =====
local function getTargetTorso(char)
	if not char then return nil end
	return char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("HumanoidRootPart")
end

local function isInMatchWithMe(otherPlayer)
	if not otherPlayer or otherPlayer == player then
		return false
	end

	local myChar = player.Character
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
	local myRoot = myChar and getTargetTorso(myChar)
	if not myChar or not myHum or myHum.Health <= 0 or not myRoot then
		return false
	end

	local otherChar = otherPlayer.Character
	local otherHum = otherChar and otherChar:FindFirstChildOfClass("Humanoid")
	local otherTorso = otherChar and getTargetTorso(otherChar)
	if not otherChar or not otherHum or otherHum.Health <= 0 or not otherTorso then
		return false
	end

	-- Verifica que esté en Workspace y en un estado activo (no sentado en lobby ni muerto)
	if not otherChar:IsDescendantOf(Workspace) then
		return false
	end

	local state = otherHum:GetState()
	if state == Enum.HumanoidStateType.Dead or state == Enum.HumanoidStateType.None then
		return false
	end

	-- Si el juego usa atributos o carpetas de partida/ronda/sala, valida coincidencia si existen
	local myMatch = player:GetAttribute("MatchId") or player:GetAttribute("RoundId") or player:GetAttribute("Arena")
	local otherMatch = otherPlayer:GetAttribute("MatchId") or otherPlayer:GetAttribute("RoundId") or otherPlayer:GetAttribute("Arena")
	if myMatch ~= nil and otherMatch ~= nil and tostring(myMatch) ~= tostring(otherMatch) then
		return false
	end

	return true
end

-- ===== TEAM CHECK (sameTeam) =====
local function sameTeam(a, b)
	if not a or not b then
		return false
	end

	local r1, r2 = a:GetAttribute("Role"), b:GetAttribute("Role")

	if r1 ~= nil and r2 ~= nil then
		local s1, s2 = tostring(r1), tostring(r2)

		if s1 ~= "FFA" and s2 ~= "FFA"
			and s1 ~= "" and s2 ~= ""
			and s1 ~= "none" and s2 ~= "none" then

			return s1 == s2
		end
	end

	local t1, t2 = a:GetAttribute("Team"), b:GetAttribute("Team")

	if t1 ~= nil and t2 ~= nil then
		local s1, s2 = tostring(t1), tostring(t2)

		if s1 ~= "" and s2 ~= "" then
			return s1 == s2
		end
	end

	return a.Team ~= nil
		and b.Team ~= nil
		and a.Team == b.Team
end

local function isEnemy(otherPlayer)
	if not otherPlayer or otherPlayer == player then
		return false
	end

	if playerExcludedNo[otherPlayer.UserId] == true then
		return false
	end

	if not isInMatchWithMe(otherPlayer) then
		return false
	end

	local mySide = playerManualSide[player.UserId]
	local otherSide = playerManualSide[otherPlayer.UserId]
	if mySide and otherSide then
		return mySide ~= otherSide
	end

	if sameTeam(player, otherPlayer) then
		return false
	end

	return true
end

-- Solo devuelve true si no hay nada (paredes, objetos, obstáculos) cubriendo al objetivo
local function isNotCovered(cam, myChar, enemyChar, targetPart)
	local origin = cam.CFrame.Position
	local direction = targetPart.Position - origin
	if direction.Magnitude <= 0.05 then
		return false
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignoreList = {myChar}
	if cam.CameraSubject and cam.CameraSubject:IsA("BasePart") then
		table.insert(ignoreList, cam.CameraSubject)
	end
	params.FilterDescendantsInstances = ignoreList

	local result = Workspace:Raycast(origin, direction, params)
	if not result then
		return false
	end

	return result.Instance:IsDescendantOf(enemyChar)
end

